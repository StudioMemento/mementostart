  "main": "<main id=\"memento-contact\">\n  <header class=\"hero content-width\" aria-labelledby=\"start-title\">\n    <h1 class=\"hero-title category-gradient\" id=\"start-title\"><span class=\"hero-line\">LET’S WORK</span><span class=\"hero-line\">TOGETHER</span></h1>\n  </header>\n\n  <section class=\"contact-section content-width\" id=\"contatti\" aria-labelledby=\"contact-title\" tabindex=\"-1\">\n    <h2 class=\"sr-only\" id=\"contact-title\">Scrivici</h2>\n    <div class=\"email-grid\">\n      <a class=\"email-card cut-frame reveal\" id=\"mm-email-project\" href=\"mailto:mementoxdesign@gmail.com\" aria-label=\"Scrivi a mementoxdesign@gmail.com\">\n        <img class=\"email-photo\" src=\"assets/images/email-project-v61.webp\" width=\"960\" height=\"640\" alt=\"\" decoding=\"async\"><span class=\"card-legibility\" aria-hidden=\"true\"><span></span><span></span><span></span></span>\n        <span class=\"icon chevron-down card-chevron\" aria-hidden=\"true\"></span>\n        <span class=\"contact-copy\"><span class=\"icon mail\" aria-hidden=\"true\"></span><span class=\"email-address contact-title\" data-project-email-label>mementoxdesign@gmail.com</span></span>\n      </a>\n      <a class=\"email-card cut-frame reveal\" id=\"mm-email-studio\" href=\"mailto:info@mementostudio.it\" aria-label=\"Scrivi a info@mementostudio.it\">\n        <img class=\"email-photo\" src=\"assets/images/email-studio-v61.webp\" width=\"960\" height=\"640\" alt=\"\" decoding=\"async\"><span class=\"card-legibility\" aria-hidden=\"true\"><span></span><span></span><span></span></span>\n        <span class=\"icon chevron-down card-chevron\" aria-hidden=\"true\"></span>\n        <span class=\"contact-copy\"><span class=\"icon mail\" aria-hidden=\"true\"></span><span class=\"email-address contact-title\" data-studio-email-label>info@mementostudio.it</span></span>\n      </a>\n    </div>\n    <nav class=\"channels\" aria-label=\"Altri modi per contattarci\">\n      <a class=\"channel cut-frame reveal\" id=\"mm-phone-link\" href=\"tel:+393285454661\" aria-label=\"Chiama +39 328 545 4661\"><img src=\"assets/images/channel-phone-v61.webp\" width=\"800\" height=\"800\" alt=\"\" loading=\"lazy\" decoding=\"async\"><span class=\"card-legibility\" aria-hidden=\"true\"><span></span><span></span><span></span></span><span class=\"icon chevron-down card-chevron\" aria-hidden=\"true\"></span><span class=\"contact-copy channel-copy\"><span class=\"icon phone\" aria-hidden=\"true\"></span><span class=\"channel-labels\"><span class=\"channel-title contact-title\" data-phone-label>+39 328 545 4661</span></span></span></a>\n      <a class=\"channel cut-frame reveal\" id=\"mm-whatsapp-link\" href=\"https://wa.me/393285454661?text=Ciao%20Memento!%20Vorrei%20parlarvi%20di%20un%20progetto.\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Scrivici su WhatsApp\"><img src=\"assets/images/channel-whatsapp-v61.webp\" width=\"800\" height=\"800\" alt=\"\" loading=\"lazy\" decoding=\"async\"><span class=\"card-legibility\" aria-hidden=\"true\"><span></span><span></span><span></span></span><span class=\"icon chevron-down card-chevron\" aria-hidden=\"true\"></span><span class=\"contact-copy channel-copy\"><span class=\"icon whatsapp\" aria-hidden=\"true\"></span><span class=\"channel-labels\"><span class=\"channel-title contact-title\">WhatsApp</span></span></span></a>\n      <a class=\"channel cut-frame reveal\" id=\"mm-instagram-link\" href=\"https://www.instagram.com/mementostudio.it/\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Apri il profilo Instagram di Memento Studio\"><img src=\"assets/images/channel-instagram-v61.webp\" width=\"800\" height=\"800\" alt=\"\" loading=\"lazy\" decoding=\"async\"><span class=\"card-legibility\" aria-hidden=\"true\"><span></span><span></span><span></span></span><span class=\"icon chevron-down card-chevron\" aria-hidden=\"true\"></span><span class=\"contact-copy channel-copy\"><span class=\"icon instagram\" aria-hidden=\"true\"></span><span class=\"channel-labels\"><span class=\"channel-title contact-title\">Instagram</span></span></span></a>\n      <a class=\"channel cut-frame reveal\" id=\"mm-fiverr-link\" href=\"https://www.fiverr.com/studio_memento\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Apri il profilo Fiverr di Memento Studio\"><img src=\"assets/images/channel-fiverr-v61.webp\" width=\"800\" height=\"800\" alt=\"\" loading=\"lazy\" decoding=\"async\"><span class=\"card-legibility\" aria-hidden=\"true\"><span></span><span></span><span></span></span><span class=\"icon chevron-down card-chevron\" aria-hidden=\"true\"></span><span class=\"contact-copy channel-copy\"><span class=\"icon fiverr\" aria-hidden=\"true\"></span><span class=\"channel-labels\"><span class=\"channel-title contact-title\">Fiverr</span></span></span></a>\n    </nav>\n  </section>\n\n  <section class=\"location-section content-width\" aria-labelledby=\"location-title\">\n    <h2 class=\"section-heading category-gradient fit-heading reveal\" id=\"location-title\">SIAMO QUI</h2>\n    <div class=\"location-board\">\n      <div class=\"map-area location-map cut-frame reveal\" id=\"mm-map-area\">\n        <div class=\"map-intro\" id=\"mm-map-intro\" hidden><span class=\"icon map-pin\" aria-hidden=\"true\"></span><p>Maniago.</p><button class=\"quiet-link\" type=\"button\" id=\"mm-load-map\">Mostra Google Maps <span class=\"icon arrow-up-right\" aria-hidden=\"true\"></span></button></div>\n        <div class=\"map-frame\" id=\"mm-map-frame\"><iframe title=\"Google Maps — Studio Memento, Maniago\" src=\"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2762.891299543338!2d12.7091736!3d46.172819499999996!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x477983c7589f96e3%3A0xc01de6724c9b8d3d!2sStudio%20Memento!5e0!3m2!1sen!2sit!4v1793534389295!5m2!1sen!2sit\" loading=\"lazy\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen></iframe></div>\n      </div>\n      <a class=\"location-card location-address-card cut-frame reveal\" id=\"mm-map-link\" href=\"https://www.google.com/maps/place/Studio+Memento/@46.1728195,12.7091736,17z/data=!3m1!4b1!4m6!3m5!1s0x477983c7589f96e3:0xc01de6724c9b8d3d!8m2!3d46.1728195!4d12.7091736!16s%2Fg%2F11xlzkk8fv?entry=ttu&amp;g_ep=EgoyMDI2MTAyOC4wIKXMDSoASAFQAw%3D%3D\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Piazza Trento 12, 33085 Maniago (PN) — Studio Memento su Google Maps\">\n        <img class=\"location-photo\" src=\"assets/images/location-address-v61.webp\" width=\"800\" height=\"800\" alt=\"\" loading=\"lazy\" decoding=\"async\">\n        <span class=\"card-legibility\" aria-hidden=\"true\"><span></span><span></span><span></span></span>\n        <span class=\"icon map-pin\" aria-hidden=\"true\"></span>\n        <address class=\"location-address\">Piazza Trento 12<span>33085 Maniago (PN)</span></address>\n      </a>\n      <div class=\"location-card location-hours-card cut-frame reveal\" aria-label=\"Orari dello studio\">\n        <img class=\"location-photo\" src=\"assets/images/location-hours-v61.webp\" width=\"800\" height=\"800\" alt=\"\" loading=\"lazy\" decoding=\"async\">\n        <span class=\"card-legibility\" aria-hidden=\"true\"><span></span><span></span><span></span></span>\n        <span class=\"icon clock\" aria-hidden=\"true\"></span>\n        <dl class=\"hours\"><div><dt>Lunedì — Venerdì</dt><dd><time datetime=\"14:00\">14:00</time><span aria-hidden=\"true\">—</span><time datetime=\"18:00\">18:00</time></dd></div></dl>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"faq-section content-width\" id=\"faq\" aria-labelledby=\"faq-title\">\n    <div class=\"faq-panel cut-frame reveal\">\n      <div class=\"faq-visual\" aria-hidden=\"true\">\n        <img class=\"faq-photo is-active\" data-faq-image=\"idea\" src=\"assets/images/faq-idea-v61.webp\" width=\"1200\" height=\"800\" alt=\"\" loading=\"lazy\" decoding=\"async\">\n        <img class=\"faq-photo\" data-faq-image=\"existing\" src=\"assets/images/faq-existing-v61.webp\" width=\"1200\" height=\"800\" alt=\"\" loading=\"lazy\" decoding=\"async\">\n        <img class=\"faq-photo\" data-faq-image=\"time\" src=\"assets/images/faq-planning-v61.webp\" width=\"1200\" height=\"800\" alt=\"\" loading=\"lazy\" decoding=\"async\">\n        <img class=\"faq-photo\" data-faq-image=\"commit\" src=\"assets/images/faq-conversation-v61.webp\" width=\"1200\" height=\"800\" alt=\"\" loading=\"lazy\" decoding=\"async\">\n      </div>\n      <h2 class=\"faq-title category-gradient\" id=\"faq-title\"><span>Frequently Asked</span> <span>Questions</span></h2>\n      <div class=\"faq-list\">\n          <details class=\"faq-item\" name=\"memento-faq\" data-faq=\"idea\" open>\n            <summary id=\"question-idea\">Basta un’idea?<span class=\"faq-toggle\" aria-hidden=\"true\"><span class=\"icon plus\"></span><span class=\"icon minus\"></span></span></summary>\n            <div class=\"faq-answer\" id=\"answer-idea\"><p>Sì. Partiamo da quello che hai in mente.</p></div>\n          </details>\n          <details class=\"faq-item\" name=\"memento-faq\" data-faq=\"existing\">\n            <summary id=\"question-existing\">E se ho già qualcosa?<span class=\"faq-toggle\" aria-hidden=\"true\"><span class=\"icon plus\"></span><span class=\"icon minus\"></span></span></summary>\n            <div class=\"faq-answer\" id=\"answer-existing\"><p>Lo guardiamo insieme e capiamo come farlo crescere.</p></div>\n          </details>\n          <details class=\"faq-item\" name=\"memento-faq\" data-faq=\"time\">\n            <summary id=\"question-time\">Costi e tempi?<span class=\"faq-toggle\" aria-hidden=\"true\"><span class=\"icon plus\"></span><span class=\"icon minus\"></span></span></summary>\n            <div class=\"faq-answer\" id=\"answer-time\"><p>Li definiamo insieme, prima di iniziare.</p></div>\n          </details>\n          <details class=\"faq-item\" name=\"memento-faq\" data-faq=\"commit\">\n            <summary id=\"question-commit\">Scriverci mi impegna?<span class=\"faq-toggle\" aria-hidden=\"true\"><span class=\"icon plus\"></span><span class=\"icon minus\"></span></span></summary>\n            <div class=\"faq-answer\" id=\"answer-commit\"><p>No. Il primo passo è conoscerci.</p></div>\n          </details>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"legal-section content-width\" aria-labelledby=\"legal-title\">\n    <div class=\"legal-card cut-frame reveal\">\n      <h2 class=\"board-title title-gradient\" id=\"legal-title\">Privacy &amp; legal</h2>\n      <div class=\"legal-layout\">\n        <nav class=\"legal-group\" aria-label=\"Privacy e cookie\"><h3>Privacy e cookie</h3><button type=\"button\" data-policy=\"privacy\">Privacy policy <span class=\"icon arrow-up-right\" aria-hidden=\"true\"></span></button><button type=\"button\" data-policy=\"cookies\">Cookie policy <span class=\"icon arrow-up-right\" aria-hidden=\"true\"></span></button><button type=\"button\" data-policy=\"preferences\">Preferenze cookie <span class=\"icon arrow-up-right\" aria-hidden=\"true\"></span></button></nav>\n        <div class=\"legal-group legal-studio\"><h3>Studio</h3><p>Memento Design Studio</p><a class=\"legal-email\" data-email-link href=\"mailto:info@mementostudio.it\">info@mementostudio.it</a><button type=\"button\" data-policy=\"studio\">Dati dello studio <span class=\"icon arrow-up-right\" aria-hidden=\"true\"></span></button></div>\n      </div>\n    </div>\n  </section>\n\n  <footer class=\"explore-section content-width\" id=\"esplora\"><a class=\"explore-link\" id=\"mm-explore\" href=\"https://mementonav.vercel.app/#start\" aria-label=\"Continua il viaggio!\"><span class=\"explore-words category-gradient\"><span class=\"explore-line\">CONTINUA</span> <span class=\"explore-line\">IL VIAGGIO!</span></span><span class=\"icon chevron-down explore-chevron\" aria-hidden=\"true\"></span></a></footer>\n</main>"
